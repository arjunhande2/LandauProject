rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only users created in Firebase Authentication can view or change inventory.
    match /inventory/{partDocument} {
      allow read, write: if request.auth != null;
    }

    // Deny access to every other collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
