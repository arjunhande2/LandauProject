rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public inventory version: anyone with the site can read and modify this collection.
    match /inventory/{document=**} {
      allow read, write: if true;
    }

    // Keep every unrelated collection blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
